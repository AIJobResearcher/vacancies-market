<?xml version="1.0"?>
<psalm
        errorLevel="1"
        resolveFromConfigFile="true"
        reportTaintAnalysis="true"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="app"/>
        <directory name="tests/Unit"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="tests/Feature"/>
            <directory name="tests/Integration"/>
            <directory name="database/migrations"/>
            <directory name="database/seeders"/>
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Psalm\LaravelPlugin\Plugin"/>
    </plugins>
    <issueHandlers>
        <PropertyNotSetInConstructor errorLevel="suppress"/>
        <UnusedClass>
            <errorLevel type="suppress"><directory name="tests/Unit"/></errorLevel>
        </UnusedClass>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress"><directory name="tests/Unit"/></errorLevel>
        </PossiblyUnusedMethod>
        <UndefinedMagicMethod>
            <errorLevel type="suppress"><directory name="tests/Unit"/></errorLevel>
        </UndefinedMagicMethod>
        <UndefinedInterfaceMethod>
            <errorLevel type="suppress"><directory name="tests/Unit"/></errorLevel>
        </UndefinedInterfaceMethod>
        <MixedMethodCall>
            <errorLevel type="suppress">
                <directory name="tests/Unit"/>
            </errorLevel>
        </MixedMethodCall>
    </issueHandlers>
</psalm>
